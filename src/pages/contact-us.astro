---
import MainLayout from "../Layouts/MainLayout.astro";

import Contact from "../data/contact";
import { Phone, Mail, MapPin } from "@lucide/astro";
---

<MainLayout page="contact-us">
    <div class="my-10 flex flex-col-reverse space-x-8 lg:flex-row">
        <div class="my-10 flex-1 lg:my-0">
            <div>
                <p class="text-3xl font-light">Lets Go</p>
                <p class="text-3xl">Start your home with us</p>
            </div>

            <form action="#" method="post" class="grid grid-cols-1 gap-4 pt-8">
                <input type="text" autocomplete="name" name="name" id="" placeholder="Your Name" class="border-b p-2" />
                <input
                    type="text"
                    autocomplete="email"
                    name="email"
                    id=""
                    placeholder="Your Email"
                    class="border-b p-2"
                />
                <input
                    name="project_type"
                    id=""
                    placeholder="Project Type (Residential / Commercial)"
                    class="border-b p-2"
                />
                <input
                    type="text"
                    autocomplete="address-level2"
                    name="city"
                    id=""
                    placeholder="City"
                    class="border-b p-2"
                />

                <textarea name="message" id="" cols="30" rows="10" placeholder="Your Message" class="border p-2"
                ></textarea>
                <input type="submit" value="Start the Conversation" class="max-w-fit border px-4 py-2" />
            </form>
        </div>
        <div class="flex-1">
            <div>
                <p class="text-xl leading-normal font-light md:text-3xl">
                    We'd love to understand your space, your requirements, and how you envision living or working within
                    it
                </p>
            </div>
            <div class="my-6 flex items-center space-x-4">
                <span class="border p-2"> <Phone class="size-8 stroke-1 sm:size-10" /></span>
                <p class="text-xl font-light md:text-2xl">{Contact.phone}</p>
            </div>
            <div class="my-6 flex items-center space-x-4">
                <span class="border p-2"> <Mail class="size-8 stroke-1 sm:size-10" /></span>
                <p class="text-xl font-light md:text-2xl">{Contact.email}</p>
            </div>
            <div class="my-6 flex items-center space-x-4">
                <span class="border p-2"> <MapPin class="size-8 stroke-1 sm:size-10" /></span>
                <p class="text-xl font-light md:text-2xl">Headquartered in Pune and Calicut, serving all over India.</p>
            </div>
        </div>
    </div>
</MainLayout>
