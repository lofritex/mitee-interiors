---
import MainLayout from "../Layouts/MainLayout.astro";

import { Phone, Mail, MapPin } from "@lucide/astro";
---

<MainLayout page="contact-us">
    <div class="my-10 flex space-x-8">
        <div class="flex-1">
            <div>
                <p class="text-3xl font-light">Lets Go</p>
                <p class="text-3xl">Start your home with us</p>
            </div>

            <form action="#" method="post" class="grid grid-cols-1 gap-4 pt-8">
                <input type="text" autocomplete="name" name="name" id="" placeholder="Your Name" class="border-b p-2" />
                <input
                    type="text"
                    autocomplete="email"
                    name="email"
                    id=""
                    placeholder="Your Email"
                    class="border-b p-2"
                />
                <textarea name="message" id="" cols="30" rows="10" placeholder="Your Message" class="border p-2"
                ></textarea>
                <input type="submit" value="Send Message" class="max-w-fit border px-4 py-2" />
            </form>
        </div>
        <div class="flex-1">
            <div class="max-w-4/5">
                <p class="text-3xl leading-normal font-light">
                    We'd love to hear about your project. Reach out to us through any of the following channels, and
                    we'll get back to you within 24 hours.
                </p>
            </div>
            <div class="my-6 flex items-center space-x-4">
                <span class="border p-2"> <Phone class="size-10 stroke-1" /></span>
                <p class="text-2xl font-light">+9112345667</p>
            </div>
            <div class="my-6 flex items-center space-x-4">
                <span class="border p-2"> <Mail class="size-10 stroke-1" /></span>
                <p class="text-2xl font-light">miteeinteriors@gmail.com</p>
            </div>
            <div class="my-6 flex items-center space-x-4">
                <span class="border p-2"> <MapPin class="size-10 stroke-1" /></span>
                <p class="text-2xl font-light">Pune, India</p>
            </div>
        </div>
    </div>
</MainLayout>
