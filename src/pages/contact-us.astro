---
import MainLayout from "../Layouts/MainLayout.astro";

import Contact from "../data/contact";
import { Mail, MapPin, Phone } from "@lucide/astro";
---

<MainLayout page="contact-us">
    <div class="my-10 flex flex-col-reverse lg:flex-row">
        <div class="mx-4 my-10 flex-1 lg:my-0">
            <div>
                <p class="text-3xl font-light">Lets Go</p>
                <p class="text-3xl">Start your home with us</p>
            </div>
            <form
                action="https://docs.google.com/forms/d/e/1FAIpQLSeIeoWzSnvgIGqyjjIqjxODjcufbLR593miOavIzirIPsZYCw/formResponse"
                method="post"
                class="grid grid-cols-1 gap-4 pt-8"
                id="the_form"
            >
                <input
                    type="text"
                    autocomplete="name"
                    name="entry.1125051525"
                    id=""
                    placeholder="Your Name"
                    class="border-b p-2"
                    required
                />
                <input
                    type="text"
                    autocomplete="email"
                    name="entry.2037057180"
                    id=""
                    placeholder="Your Email"
                    class="border-b p-2"
                    required
                />

                <div class="flex flex-col">
                    <select
                        name="entry.217436386"
                        id="project_type"
                        class="border-b bg-white p-2"
                        required
                    >
                        <option value="" disabled selected>Select Project Type</option>
                        <option value="Residential">Residential</option>
                        <option value="Commercial">Commercial</option>
                        <option value="Both">Both</option>
                    </select>
                    <span id="project_type_error" class="mt-1 hidden text-xs text-red-500"
                        >Please select a valid project type.</span
                    >
                </div>

                <input
                    type="text"
                    autocomplete="address-level2"
                    name="entry.78311827"
                    id=""
                    placeholder="City"
                    class="border-b p-2"
                    required
                />

                <div class="flex flex-col">
                    <select
                        name="entry.1935969012"
                        id="budget"
                        class="border-b bg-white p-2"
                        required
                    >
                        <option value="" disabled selected>Select Tenative Budget</option>
                        <option value="₹10 Lakhs - ₹15 Lakhs">₹10 Lakhs - ₹15 Lakhs</option>
                        <option value="₹15 Lakhs - ₹20 Lakhs">₹15 Lakhs - ₹20 Lakhs</option>
                        <option value="₹20 Lakhs - ₹25 Lakhs">₹20 Lakhs - ₹25 Lakhs</option>
                        <option value="₹25 Lakhs - ₹30 Lakhs">₹25 Lakhs - ₹30 Lakhs</option>
                        <option value="₹30 Lakhs - ₹35 Lakhs">₹30 Lakhs - ₹35 Lakhs</option>
                        <option value="₹35 Lakhs & Above">₹35 Lakhs & Above</option>
                    </select>
                    <span id="budget_error" class="mt-1 hidden text-xs text-red-500"
                        >Please select a valid budget.</span
                    >
                </div>

                <textarea
                    name="entry.1064524180"
                    id=""
                    cols="30"
                    rows="10"
                    placeholder="Scope of Work"
                    class="border p-2"
                    required></textarea>
                <input
                    type="submit"
                    value="Start the Conversation"
                    class="max-w-fit border px-4 py-2"
                />
            </form>
        </div>
        <div class="mx-4 flex-1">
            <div>
                <p class="text-xl leading-normal font-light md:text-2xl">
                    We'd love to understand your space, your requirements, and how you envision
                    living or working within it
                </p>
            </div>
            <div class="my-6 flex items-center space-x-4">
                <span class="p-2"> <Phone class="size-8 stroke-1" /></span>
                <p class="text-xl font-light">{Contact.phone}</p>
            </div>
            <div class="my-6 flex items-center space-x-4">
                <span class="p-2"> <Mail class="size-8 stroke-1" /></span>
                <p class="text-xl font-light">{Contact.email}</p>
            </div>
            <div class="my-6 flex space-x-4">
                <section class="text-xl font-light">
                    <ul class="ml-2 space-y-4">
                        <li>
                            <h3 class="my-2">Pune Office</h3>
                            <p class="pl-4 text-base">
                                Office No. G1, Ground Floor, Bharati Niwas Housing Society<br />
                                Jaygad Marg, Lane Opp. to Income Tax Office<br />
                                Erandawane, Pune 411004
                            </p>
                        </li>
                        <hr />
                        <li>
                            <h3 class="my-2">Calicut Office</h3>
                            <p class="pl-4 text-base">
                                Taas Flora Mini, 64/816<br />
                                Mini Bypass Road, Near Old Passport Office<br />
                                Kozhikode, Kerala 673006
                            </p>
                        </li>
                    </ul>
                </section>
            </div>
        </div>
    </div>
    <script>
        const myForm = document.getElementById("the_form") as HTMLFormElement | null;

        if (myForm) {
            myForm.addEventListener("submit", async (e: SubmitEvent): Promise<void> => {
                e.preventDefault(); // This stops the redirect to Google

                // 2. Prepare the data
                const formData = new FormData(myForm);

                try {
                    // 3. Send the data to Google Forms
                    await fetch(myForm.action, {
                        method: "POST",
                        mode: "no-cors", // Crucial: prevents CORS errors
                        body: formData,
                    });

                    // 4. Success! Do something on your site instead of redirecting
                    alert("Success! We'll get back to you soon.");
                    myForm.reset(); // Optional: Clear the form
                } catch (error) {
                    console.error("Submission error:", error);
                    alert("Something went wrong. Please try again.");
                }
            });
        }
    </script>
</MainLayout>
