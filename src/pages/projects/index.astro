---
import MainLayout from "../../Layouts/MainLayout.astro";

import { Image } from "astro:assets";
import HightLight1 from "../../assets/h1.png";
import HightLight2 from "@assets/projects/amana-toyota/01.jpg";
import HightLight3 from "@assets/projects/slate-home/03.jpg";

import { ChevronLeft, ChevronRight, MapPin } from "@lucide/astro";
import { toTitleCase } from "@utils/titleCase.ts";
import { getCollection } from "astro:content";

import { shuffle } from "@utils/shuffle";

const rawPosts = await getCollection("projects");

const posts = rawPosts.sort(
    (a, b) => b.data.completionDate.getTime() - a.data.completionDate.getTime(),
);

const featuredSlugs = ["sky-garden", "zen-house", "eccentric"];

const featuredProjects = posts
    .filter((p) => featuredSlugs.includes(p.slug))
    .map((d) => ({
        slug: d.slug,
        projectName: d.data.title,
        images: shuffle(d.data.images!).slice(0, 4),
    }));

import "swiper/css";
import "swiper/css/grid";
import "swiper/css/navigation";
import "swiper/css/pagination";
import "swiper/css/autoplay";
