<style is:global>
    /* 2. Force Swiper to calculate the height of two rows perfectly with the gap */
    .projects-swiper .swiper-grid-column .swiper-slide {
        margin-top: 0px !important;
        /* Formula: (100% inner container height - spaceBetween) / 2 rows */
        height: calc((100% - 30px) / 2) !important;
    }
</style>

<style>
    @keyframes scrollVertical {
        0% {
            transform: translateY(0);
        }
        100% {
            transform: translateY(-50%);
        }
    }

    .swiper-slide.swiper-slide-hidden {
        display: none !important;
    }

    /* --- Custom Numbered Pagination Styles --- */
    .custom-pagination-container {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        margin-top: 2.5rem;
    }

    /* Target the generated Swiper bullets to look like numbered buttons */
    .custom-pagination-container .swiper-pagination-bullet {
        width: 2.5rem;
        height: 2.5rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #e5e7eb; /* border-gray-200 */
        background: transparent;
        color: #1f2937; /* text-gray-800 */
        opacity: 1;
        border-radius: 0.375rem; /* rounded-md */
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
    }

    /* Active state for the numbered button */
    .custom-pagination-container .swiper-pagination-bullet-active {
        background-color: #000000; /* bg-black */
        color: #ffffff; /* text-white */
        border-color: #000000;
    }

    /* Style for disabled navigation buttons when at the start/end */
    .nav-btn.swiper-button-disabled {
        opacity: 0.4;
        cursor: not-allowed;
        pointer-events: none;
    }

    :root {
        --swiper-theme-color: black;
    }
</style>

<script>
    import Swiper from "swiper";
    import { Grid, Pagination, Navigation } from "swiper/modules";

    let swiperInstance: Swiper | null = null;
    // Keep a master copy of all initial slides to restore when filters change
    let allSlides: HTMLDivElement[] = [];

    function initSwiper() {
        // Destroy existing instance before creating a new one to prevent layout memory leaks
        if (swiperInstance) {
            swiperInstance.destroy(true, true);
        }

        swiperInstance = new Swiper(".projects-swiper", {
            modules: [Grid, Pagination, Navigation],
            slidesPerView: 3,
            slidesPerGroup: 3,
            grid: {
                rows: 2,
                fill: "row",
            },
            spaceBetween: 30,

            observer: true,
            observeParents: true,
            updateOnWindowResize: true,

            pagination: {
                el: ".projects-numbered-pagination",
                clickable: true,
            },

            navigation: {
                nextEl: ".next-project-btn",
                prevEl: ".prev-project-btn",
            },

            breakpoints: {
                320: { slidesPerView: 1, slidesPerGroup: 1, grid: { rows: 1 } },
                768: { slidesPerView: 3, slidesPerGroup: 3, grid: { rows: 2 } },
            },
        });
    }

    function setupFilters() {
        const wrapper = document.querySelector(".projects-swiper .swiper-wrapper");
        const buttons = document.querySelectorAll(".filter-btn");

        if (!wrapper) return;

        // Cache the original set of slide elements
        allSlides = Array.from(wrapper.querySelectorAll<HTMLDivElement>(".swiper-slide"));

        buttons.forEach((btn) => {
            btn.addEventListener("click", (e) => {
                const target = e.currentTarget as HTMLButtonElement;
                if (target) {
                    const filterValue = target.getAttribute("data-category");

                    // Toggle active classes for UI styling
                    buttons.forEach((b) => b.classList.remove("bg-black", "text-white", "active"));
                    buttons.forEach((b) => b.classList.add("bg-white", "text-black"));
                    target.classList.add("text-black", "active");
                    target.classList.remove("bg-white", "text-black");

                    // Clear current slides inside the wrapper
                    wrapper.innerHTML = "";

                    // Filter elements and re-append them to the DOM
                    const filteredSlides = allSlides.filter((slide) => {
                        const slideCategory = slide.getAttribute("data-category");
                        return filterValue === "all" || slideCategory === filterValue;
                    });

                    filteredSlides.forEach((slide) => wrapper.appendChild(slide));

                    // Re-initialize Swiper so it calculates grid slots accurately based on new count
                    initSwiper();
                }
            });
        });
    }

    document.addEventListener("DOMContentLoaded", () => {
        setupFilters();
        initSwiper();
    });
</script>

<script>
    import Swiper from "swiper";
    import { Autoplay } from "swiper/modules";

    const swiper = new Swiper(".highlight-swiper", {
        modules: [Autoplay],
        loop: true,
        speed: 3000,
        spaceBetween: 8,
        autoplay: {
            delay: 3000,
            disableOnInteraction: false,
        },
        slidesPerView: "auto",
    });
</script>
