---
import MainLayout from "../Layouts/MainLayout.astro";
---

<MainLayout page="404">
    <section class="my-10 flex flex-col items-center">
        <h1 class="mb-6 text-7xl font-extrabold">404</h1>

        <p class="mb-4 text-2xl font-semibold">Oops! Page not found.</p>

        <p class="mb-8 max-w-lg text-center text-gray-600">
            We can't seem to find the page you're looking for. It might have been removed, had its
            name changed, or is temporarily unavailable.
        </p>

        <a href="/" class="inline-block rounded-lg border px-4 py-2"> ← Back to Home </a>
    </section>
</MainLayout>
