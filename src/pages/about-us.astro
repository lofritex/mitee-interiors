---
import { Image } from "astro:assets";
import MainLayout from "../Layouts/MainLayout.astro";

import About1 from "../assets/about1.png";
import About2 from "../assets/about2.png";

import Team from "../assets/team.jpg";
import ClientReviews from "../components/ClientReviews.astro";

const qualities = [
    {
        label: "Authenticity Over Aesthetics",
        content:
            "In a world driven by fast trends, Mitee Interiors chooses depth over display. Our work is rooted in authenticity—designing spaces around people, not appearances. Every interior is shaped by how it feels to live or work within it, allowing beauty to emerge naturally from purpose and thought.",
    },

    {
        label: "Personalisation,Not Replication",
        content:
            "No two Mitee projects are ever alike. We don't work from templates or fixed styles. Each space evolves through conversation, context, and careful observation—resulting in interiors that reflect real lives, not replicated aesthetics.",
    },
    {
        label: "Design-First, Execution-Focused",
        content:
            "We operate as a design-led studio where concept and clarity lead every decision. From spatial planning and material selection to on-site execution, we ensure the original design intent is respected and translated with precision—through close collaboration with our teams and partners",
    },
];

const aboutDetails = [
    // {
    //     title: "Myself",
    //     content: [
    //         "Lorem ipsum dolor sit amet consectetur adipisicing elit. Quas alias tempora et laboriosam qui cum atque velit quis inventore. Asperiores!",
    //     ],
    //     img: Myself,
    // },
    {
        title: "Our Team",
        content: [
            "At Mitee Interiors, we are a close-knit team of designers, project coordinators, and site professionals who share a passion for thoughtful design and meticulous execution.",

            "Led by founder and principal designer Sanjali Naik, our team combines creativity with technical expertise to guide projects from concept to completion. We work collaboratively with clients, consultants, vendors, and contractors to ensure that every detail is considered and every design vision is translated effectively on site.",

            "What sets our team apart is our hands-on approach. We believe successful projects are built through communication, coordination, and a genuine commitment to understanding our clients' needs.",
        ],
        img: Team,
    },

    {
        title: "Our Story",
        content: [
            "Mitee Interiors was founded by Sanjali Naik with a passion for creating spaces that are both functional and aesthetically timeless. After gaining two years of hands-on industry experience, Sanjali established Mitee Interiors with the vision of delivering thoughtful, client-centric design solutions.",

            "Sanjali graduated as the topper of her Interior Design Diploma program and also holds a Bachelor of Commerce degree, bringing together creative expertise and business acumen. What began as a small-scale design practice has steadily evolved into a multidisciplinary design studio undertaking larger and more complex residential and commercial projects.",

            "Today, with offices in Pune and Calicut and over 8 years of industry experience, Mitee Interiors serves clients across India. While the scale of our projects has grown, our philosophy remains unchanged. We believe that exceptional design comes from attention, involvement, and a deep understanding of each client's needs.",

            "As we continue to take on larger projects, our focus is not on the number of sites we handle, but on the quality of design we deliver. We consciously prioritize a design-oriented approach, ensuring that every project receives the time, thought, and attention it deserves. For us, success is measured not by volume, but by the value we create through meaningful, well-considered design.",

            "This commitment allows us to create spaces that are not only visually appealing but also functional, timeless, and uniquely tailored to the people who use them.",
        ],
        img: About1,
    },
    {
        title: "What Do We Do?",
        content: [
            "At Mitee Interiors, we offer Interior Design, Architectural Consultation, Façade Design, and Landscape Design services, helping clients create spaces that are cohesive, functional, and thoughtfully designed from the inside out.",

            "We believe that great design begins with understanding people. Many clients know how they want their space to feel, but often find it difficult to translate their ideas into a clear vision. Our role is to help bring clarity to that vision and transform it into a space that truly reflects their lifestyle and aspirations.",

            "We take the time to understand our clients' preferences, daily routines, and design sensibilities. By carefully studying the themes, materials, and aesthetics they are naturally drawn to, we create spaces that are uniquely tailored to them. Rather than following short-lived trends, we focus on designing environments that are timeless, functional, and deeply personal.",

            "Whether we are designing a residence, commercial space, healthcare facility, or hospitality project, our approach remains the same: to create spaces that balance beauty with practicality and enhance the way people experience their environment.",

            "The greatest reward for us is seeing our clients truly live in the spaces we design—whether it is enjoying quiet moments at home, gathering with loved ones, welcoming customers into their business, or carrying out their everyday routines with ease. Knowing that our designs become a meaningful part of their daily lives is what inspires us to do what we do.",
        ],
        img: About2,
    },
];
---

<MainLayout page="about-us">
    <section class="my-10 border-b pb-10">
        {
            aboutDetails.map((detail, index) => {
                const isFlipped = index % 2 === 1;

                return (
                    <div
                        class:list={[
                            "flex flex-col items-center lg:flex-row",
                            { "lg:flex-row-reverse": isFlipped },
                        ]}
                    >
                        <div class="flex-1 p-10">
                            <Image
                                src={detail.img}
                                alt=""
                                class="aspect-square bg-bottom object-cover"
                            />
                        </div>
                        <div class="flex-1">
                            <h3 class="my-4 text-center text-2xl">{detail.title}</h3>
                            <div class="flex flex-col gap-4">
                                {Array.isArray(detail.content) ? (
                                    detail.content.map((paragraph) => (
                                        <p class="mx-auto text-center text-lg font-light sm:text-left">
                                            {paragraph}
                                        </p>
                                    ))
                                ) : (
                                    <p class="mx-auto text-center text-lg font-light lg:text-left">
                                        {detail.content}
                                    </p>
                                )}
                            </div>
                        </div>
                    </div>
                );
            })
        }
    </section>

    <section class="border-b py-10">
        <h3 class="my-10 text-center text-2xl">Why Mitee Interiors?</h3>

        <div>
            {
                qualities.map((quality) => (
                    <div class="my-4 flex flex-col items-center border p-4 py-8 sm:flex-row">
                        <h3 class="flex-[30%] px-4 py-8 text-center text-xl sm:text-2xl">
                            {quality.label}
                        </h3>
                        <p class="flex-[70%] font-light">{quality.content}</p>
                    </div>
                ))
            }
        </div>
    </section>

    <ClientReviews />
</MainLayout>
