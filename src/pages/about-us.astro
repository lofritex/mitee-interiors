---
import { Image } from "astro:assets";
import MainLayout from "../Layouts/MainLayout.astro";

import AboutImg from "../assets/aboutImg.png";

import About1 from "../assets/about1.png";
import About2 from "../assets/about2.png";

import Myself from "../assets/myself.jpg";
import Team from "../assets/team.jpg";

const qualities = [
    {
        label: "Authenticity Over Aesthetics",
        content:
            "In a world driven by fast trends, Mitee Interiors chooses depth over display. Our work is rooted in authenticity—designing spaces around people, not appearances. Every interior is shaped by how it feels to live or work within it, allowing beauty to emerge naturally from purpose and thought.",
    },

    {
        label: "Personalisation,Not Replication",
        content:
            "No two Mitee projects are ever alike. We don't work from templates or fixed styles. Each space evolves through conversation, context, and careful observation—resulting in interiors that reflect real lives, not replicated aesthetics.",
    },
    {
        label: "Design-First, Execution-Focused",
        content:
            "We operate as a design-led studio where concept and clarity lead every decision. From spatial planning and material selection to on-site execution, we ensure the original design intent is respected and translated with precision—through close collaboration with our teams and partners",
    },
];

const aboutDetails = [
    // {
    //     title: "Myself",
    //     content: [
    //         "Lorem ipsum dolor sit amet consectetur adipisicing elit. Quas alias tempora et laboriosam qui cum atque velit quis inventore. Asperiores!",
    //     ],
    //     img: Myself,
    // },
    {
        title: "Our Team",
        content: [
            "Led by Principal Designer Sanjali Naik, our team is a warm blend of creative designers and skilled craftsmen who treat every project like our own. We work closely with you to turn your vision into a beautiful, functional reality. At Mitee Interiors, we don’t just design spaces—we create the heart of your home.",
        ],
        img: Team,
    },

    {
        title: "Our Story",
        content: [
            "Derived from the Sanskrit word “Bhumitee,” meaning dimension, Mitee Interiors is a design studio focused on creating refined, functional, and thoughtfully curated interiors.",
            "With over 8 years of experience, we specialise in residential and commercial interior design, delivering spaces that balance aesthetics, practicality, and long-term value. From concept to execution, every project is approached with attention to detail and a deep understanding of our client's lifestyles and business needs. ",
        ],
        img: About1,
    },
    {
        title: "What Do We Do?",
        content: [
            " We design interiors that feel personal, intentional, and enduring. Whether it's a home or a workspace, our process begins with understanding how you live, move, and interact with your environment.",
            "Each design is developed from scratch—carefully layered with materiality, proportion, and detail—to create spaces that are not only beautiful, but meaningful and lasting.",
        ],
        img: About2,
    },
];
---

<MainLayout page="about-us">
    <section class="my-10 border-b pb-10">
        {
            aboutDetails.map((detail, index) => {
                const isFlipped = index % 2 === 1;

                return (
                    <div
                        class:list={[
                            "flex flex-col items-center sm:flex-row",
                            { "sm:flex-row-reverse": isFlipped },
                        ]}
                    >
                        <div class="flex-1 p-10">
                            <Image
                                src={detail.img}
                                alt=""
                                class="aspect-square bg-bottom object-cover"
                            />
                        </div>
                        <div class="flex-1">
                            <h3 class="my-4 text-center text-2xl">{detail.title}</h3>
                            <div class="flex flex-col gap-4">
                                {Array.isArray(detail.content) ? (
                                    detail.content.map((paragraph) => (
                                        <p class="mx-auto text-center text-lg font-light sm:text-left">
                                            {paragraph}
                                        </p>
                                    ))
                                ) : (
                                    <p class="mx-auto text-center text-lg font-light sm:text-left">
                                        {detail.content}
                                    </p>
                                )}
                            </div>
                        </div>
                    </div>
                );
            })
        }
    </section>

    <section class="border-b py-10">
        <h3 class="my-10 text-center text-2xl">Why Mitee Interiors?</h3>

        <div>
            {
                qualities.map((quality) => (
                    <div class="my-4 flex flex-col items-center border p-4 py-8 sm:flex-row">
                        <h3 class="flex-[30%] px-4 py-8 text-center text-xl sm:text-2xl">
                            {quality.label}
                        </h3>
                        <p class="flex-[70%] font-light">{quality.content}</p>
                    </div>
                ))
            }
        </div>
    </section>

    <section class="py-10">
        <h3 class="mb-10 text-center text-3xl">Client Reviews</h3>

        <div class="flow-visible flex grid-cols-3 gap-4 overflow-x-auto sm:grid">
            <div class="min-w-[80vw] border p-6 sm:min-w-0">
                <p class="aspect-square text-center font-light">
                    "Thanks a lot for all the hard work. The house is really looking good. Touch
                    wood. I really appreciate all the efforts and time you had given to our home. It
                    was really good to work with you. The professionalism you carry is good and keep
                    it up. We started our discussions in Oct-Nov and you had everything very clear
                    in your mind (approach, Designs, Selections). I wish you all the very best and I
                    am sure you would reach new heights for sure."
                </p>

                <p class="my-2 text-center font-medium">- Abhishek & Kirti Hadap</p>
            </div>
            <div class="min-w-[80vw] border p-6 sm:min-w-0">
                <p class="aspect-square text-center font-light">
                    "Creativity and simplicity at its best....!!! We selected Saanjali from the
                    number of options that we had and when we saw the first design that she
                    proposed, we knew that something great is coming. We trusted in her talent and
                    she didn't let us down. Very unique design elements used for TV pannel, terrace
                    garden, bathroom and bedrooms which we had never seen anywhere. Special thanks
                    for making my dream terraces garden, a reality. Our relatives and friends just
                    couldn't stop complimenting our house."
                </p>

                <p class="my-2 text-center font-medium">- Hemant & Akshata Sonawane</p>
            </div>
            <div class="min-w-[80vw] border p-6 sm:min-w-0">
                <p class="aspect-square text-center font-light">
                    "First of all thank you so much for creating my dream office just the way I
                    wanted. I had so many ideas when I started thinking about the office interior
                    and offcourse I shared all of my ideas with saanjali. What I really liked about
                    her is that she actually considers your choice and ideas while designing. "
                </p>

                <p class="my-2 text-center font-medium">- CA Mayur Tapkir</p>
            </div>
        </div>
    </section>
</MainLayout>
