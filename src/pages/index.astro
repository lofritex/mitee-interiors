---
import { Image } from "astro:assets";
import MainLayout from "../Layouts/MainLayout.astro";

import Special1 from "../assets/Special_2.jpg";
import Special2 from "../assets/projects/greige-house/07.jpg";
import Special3 from "../assets/Special_3.jpg";

import Myself from "../assets/myself.jpg";

import { CircleArrowRight } from "@lucide/astro";
import ClientImage from "../assets/client.png";

import "swiper/css";
import "swiper/css/autoplay";
import "swiper/css/pagination";
import ClientReviews from "../components/ClientReviews.astro";
import { carouselData } from "../data/carousel";
---

<MainLayout page="home">
    <section class="border-b py-10">
        <div class="swiper carousel">
            <div class="swiper-wrapper">
                {
                    carouselData.map((carousel) => (
                        <div class="swiper-slide relative">
                            <Image
                                src={carousel.image}
                                alt="Dinning Room Decorations"
                                class="aspect-2/1 min-h-[calc(80dvh)] bg-center object-cover md:min-h-[calc(100dvh-300px)]"
                            />
                            <div class="to-peach via-peach absolute right-0 bottom-0 left-0 flex h-24 items-center justify-center bg-linear-to-b from-transparent via-80%">
                                <p class="text-center text-2xl text-white">
                                    Design with Depth, Detail, and Distinction
                                </p>
                            </div>
                        </div>
                    ))
                }
            </div>

            <div class="swiper-pagination"></div>
        </div>
    </section>

    <section class="flex flex-col space-y-4 space-x-4 border-b py-10 md:flex-row md:space-y-0">
        <div class="flex w-full flex-1 items-center justify-center">
            <Image src={Myself} alt="" class="aspect-square h-full w-full bg-bottom object-cover" />
        </div>
        <div class="flex flex-1 flex-col items-center justify-center space-y-4">
            <h3 class="w-4/5 text-center text-2xl">
                Mitee Is a Nationally Renowned Studio Crafting Distinctive Spaces.
            </h3>
            <p class="text-center text-lg font-light">
                Derived from the Sanskrit word “Bhumitee,” meaning dimension, Mitee is a design
                studio crafting refined, functional spaces. Based in Pune and Calicut, the studio
                brings its vision of purposeful aesthetics to projects across India.
            </p>
            <a href="/about-us">
                <button
                    class="flex items-center space-x-2 rounded-2xl border border-white px-6 py-2 text-xl hover:border-black"
                    ><span>Learn More About Us</span> <CircleArrowRight /></button
                >
            </a>
        </div>
    </section>

    <section class="border-b py-10">
        <div class="w-full flex-col items-center justify-center">
            <h3 class="text-center text-2xl font-light">Every Space, Uniquely Designed.</h3>

            <div class="my-10 grid grid-cols-3 place-items-center gap-4">
                <Image
                    src={Special1}
                    alt="Special 1"
                    class="aspect-4/5 object-cover object-center"
                />
                <Image
                    src={Special2}
                    alt="Special 2"
                    class="aspect-4/5 object-cover object-center"
                />
                <Image
                    src={Special3}
                    alt="Special 3"
                    class="aspect-4/5 object-cover object-center"
                />
            </div>
        </div>
        <div class="flex justify-center">
            <a href="/projects">
                <button class="cursor-pointer rounded-2xl border px-3 py-2 sm:px-6 sm:py-4"
                    >Explore Projects</button
                >
            </a>
        </div>
    </section>

    <section class="border-b py-10">
        <div class="flex flex-col items-center space-x-4 sm:flex-row">
            <div class="flex-1">
                <Image src={ClientImage} alt="Kitchen Island" />
            </div>
            <div
                class="my-8 flex flex-1 flex-col justify-around space-y-8 sm:my-0 sm:pl-10 md:space-y-8 lg:space-y-16"
            >
                <div>
                    <h4 class="text-2xl">50+ Happy Clients</h4>
                    <p class="text-xl font-light">Trusted by Homeowners and Brands Across India.</p>
                </div>
                <div>
                    <h4 class="text-2xl">100+ Spaces Designed</h4>
                    <p class="text-xl font-light">From Cozy Homes to Bold Commercial Interiors.</p>
                </div>
                <div>
                    <h4 class="text-2xl">5+ Years of Experience</h4>
                    <p class="text-xl font-light">
                        Blending Vision with Functionality Since Day One.
                    </p>
                </div>
                <div>
                    <h4 class="text-2xl">20+ Cities Reached</h4>
                    <p class="text-xl font-light">Designs That Travel Far Beyond Pune.</p>
                </div>
                <div>
                    <h4 class="text-2xl">100+ Spaces Designed</h4>
                    <p class="text-xl font-light">From Cozy Homes to Bold Commercial Interiors.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="border-b py-10">
        <div class="flex flex-col items-center justify-center space-y-8">
            <h3 class="text-center text-2xl">Ready to Transform Your Space?</h3>
            <p class="my-4 max-w-lg text-center">
                Designing Homes with Intention Every project begins with listening—understanding
                your lifestyle, needs, and vision.
            </p>
            <a href="/contact-us">
                <button
                    class="cursor-pointer rounded-2xl border px-6 py-2 duration-100 ease-in hover:bg-black hover:text-white"
                    >Discuss Your Project</button
                >
            </a>
        </div>
    </section>
    <ClientReviews />
</MainLayout>

<style>
    :root {
        --swiper-theme-color: #fff;
    }
</style>

<script>
    import Swiper from "swiper";
    import { Autoplay, Pagination } from "swiper/modules";

    const swiper = new Swiper(".carousel", {
        modules: [Autoplay, Pagination],
        effect: "fade",
        autoplay: {
            delay: 3000,
            disableOnInteraction: false,
        },
        initialSlide: 2,
        loop: true,
        pagination: {
            el: ".swiper-pagination",
            clickable: true,
            dynamicBullets: true,
        },
    });
</script>
