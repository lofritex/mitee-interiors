---
import { Image } from "astro:assets";
import MainLayout from "../Layouts/MainLayout.astro";

import Lander from "../assets/lander.png";

import Special1 from "../assets/Special_1.png";
import Special2 from "../assets/Special_2.png";
import Special3 from "../assets/Special_3.png";

import Myself from "../assets/myself.jpg";

import ClientImage from "../assets/client.png";
import { CircleArrowRight } from "@lucide/astro";
---

<MainLayout page="home">
    <section class="border-b py-10">
        <div class="relative">
            <Image src={Lander} alt="Landing Image" class="min-h-[calc(100dvh-300px)] bg-center object-cover" />

            <div
                class="to-peach via-peach absolute right-0 bottom-0 left-0 flex h-24 items-center justify-center bg-linear-to-b from-transparent via-80%"
            >
                <p class="text-center text-2xl text-white">Design with Depth, Detail, and Distinction</p>
            </div>
        </div>
    </section>

    <section class="flex flex-col space-y-4 space-x-4 border-b py-10 md:flex-row md:space-y-0">
        <div class="flex flex-1 items-center justify-center">
            <Image src={Myself} alt="" class="aspect-square bg-bottom object-cover" />
        </div>
        <div class="flex flex-1 flex-col items-center justify-center space-y-4">
            <h3 class="w-4/5 text-center text-2xl">
                Mitee Is a Nationally Renowned Studio Crafting Distinctive Spaces.
            </h3>
            <p class="text-center text-lg font-light">
                Derived from the Sanskrit word “Bhumitee,” meaning dimension, Mitee is a design studio crafting refined,
                functional spaces. Based in Pune and Calicut, the studio brings its vision of purposeful aesthetics to
                projects across India.
            </p>
            <a href="/about-us">
                <button
                    class="flex items-center space-x-2 rounded-2xl border border-white px-6 py-2 text-xl hover:border-black"
                    ><span>Learn More About Us</span> <CircleArrowRight /></button
                >
            </a>
        </div>
    </section>

    <section class="border-b py-10">
        <div class="w-full flex-col items-center justify-center">
            <h3 class="text-center text-2xl font-light">Every Space, Uniquely Designed.</h3>

            <div class="my-10 grid grid-cols-3 place-items-center gap-4">
                <Image src={Special1} alt="Special 1" />
                <Image src={Special2} alt="Special 2" />
                <Image src={Special3} alt="Special 3" />
            </div>
        </div>
        <div class="flex justify-center">
            <a href="/projects">
                <button class="cursor-pointer rounded-2xl border px-3 py-2 sm:px-6 sm:py-4">Explore Projects</button>
            </a>
        </div>
    </section>

    <section class="border-b py-10">
        <div class="flex flex-col items-center space-x-4 sm:flex-row">
            <div class="flex-1">
                <Image src={ClientImage} alt="Client Image" />
            </div>
            <div class="my-8 flex flex-1 flex-col justify-around space-y-8 sm:my-0 sm:pl-10 md:space-y-8 lg:space-y-16">
                <div>
                    <h4 class="text-2xl">50+ Happy Clients</h4>
                    <p class="text-xl font-light">Trusted by Homeowners and Brands Across India.</p>
                </div>
                <div>
                    <h4 class="text-2xl">100+ Spaces Designed</h4>
                    <p class="text-xl font-light">From Cozy Homes to Bold Commercial Interiors.</p>
                </div>
                <div>
                    <h4 class="text-2xl">5+ Years of Experience</h4>
                    <p class="text-xl font-light">Blending Vision with Functionality Since Day One.</p>
                </div>
                <div>
                    <h4 class="text-2xl">20+ Cities Reached</h4>
                    <p class="text-xl font-light">Designs That Travel Far Beyond Pune.</p>
                </div>
                <div>
                    <h4 class="text-2xl">100+ Spaces Designed</h4>
                    <p class="text-xl font-light">From Cozy Homes to Bold Commercial Interiors.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="border-b py-10">
        <div class="flex flex-col items-center justify-center space-y-8">
            <h3 class="text-center text-2xl">Ready to Transform Your Space?</h3>
            <p class="my-4 max-w-lg text-center">
                Designing Homes with Intention Every project begins with listening—understanding your lifestyle, needs,
                and vision.
            </p>
            <a href="/contact-us">
                <button class="rounded-2xl border px-6 py-2">Discuss Your Project</button>
            </a>
        </div>
    </section>

    <section class="py-10">
        <h3 class="mb-10 text-center text-3xl">Client Reviews</h3>

        <div class="flex grid-cols-3 gap-4 overflow-x-auto sm:grid sm:overflow-visible">
            <div class="min-w-[80vw] border p-6 sm:min-w-0">
                <p class="aspect-square text-center font-light">
                    "Thanks a lot for all the hard work. The house is really looking good. Touch wood. I really
                    appreciate all the efforts and time you had given to our home. It was really good to work with you.
                    The professionalism you carry is good and keep it up. We started our discussions in Oct-Nov and you
                    had everything very clear in your mind (approach, Designs, Selections). I wish you all the very best
                    and I am sure you would reach new heights for sure."
                </p>

                <p class="my-2 text-center font-medium">- Abhishek & Kirti Hadap</p>
            </div>
            <div class="min-w-[80vw] border p-6 sm:min-w-0">
                <p class="aspect-square text-center font-light">
                    "Creativity and simplicity at its best....!!! We selected Saanjali from the number of options that
                    we had and when we saw the first design that she proposed, we knew that something great is coming.
                    We trusted in her talent and she didn't let us down. Very unique design elements used for TV pannel,
                    terrace garden, bathroom and bedrooms which we had never seen anywhere. Special thanks for making my
                    dream terraces garden, a reality. Our relatives and friends just couldn't stop complimenting our
                    house."
                </p>

                <p class="my-2 text-center font-medium">- Hemant & Akshata Sonawane</p>
            </div>
            <div class="min-w-[80vw] border p-6 sm:min-w-0">
                <p class="aspect-square text-center font-light">
                    "First of all thank you so much for creating my dream office just the way I wanted. I had so many
                    ideas when I started thinking about the office interior and offcourse I shared all of my ideas with
                    saanjali. What I really liked about her is that she actually considers your choice and ideas while
                    designing. "
                </p>

                <p class="my-2 text-center font-medium">- CA Mayur Tapkir</p>
            </div>
        </div>
    </section>
</MainLayout>
