---
import type { PageValue } from "../Layouts/MainLayout.astro";
import { navItems } from "../data/navItems";

interface Props {
    page: PageValue;
}

const { page } = Astro.props as Props;
---

<nav class="sticky top-0 z-50 flex w-full justify-center border-t-2 border-b border-gray-400 bg-white py-4">
    <ul class="flex items-end gap-4">
        {
            navItems.map((item) => (
                <li>
                    <a
                        href={item.href}
                        class={page === item.id ? "text-lg font-medium underline underline-offset-2" : "text-gray-800"}
                    >
                        {item.name}
                    </a>
                </li>
            ))
        }
    </ul>
</nav>
