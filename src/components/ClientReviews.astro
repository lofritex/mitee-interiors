---
import "swiper/css";
import "swiper/css/autoplay";
import "swiper/css/pagination";

import { testimonials } from "../data/testimonials";
---

<section class="py-10">
    <h3 class="mb-10 text-center text-3xl">Client Reviews</h3>

    <div class="swiper testimonials">
        <div class="swiper-wrapper">
            {
                testimonials.map((testimonial) => (
                    <div class="swiper-slide min-w-[80vw] border p-6 sm:min-w-0">
                        <p class="aspect-square font-light">{testimonial.content}</p>

                        <p class="my-2 text-center font-medium">- {testimonial.author}</p>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<script>
    import Swiper from "swiper";
    import { Autoplay, Pagination } from "swiper/modules";

    new Swiper(".testimonials", {
        modules: [Autoplay, Pagination],
        effect: "fade",
        slidesPerView: 3,
        spaceBetween: 10,
        autoplay: {
            delay: 3000,
            disableOnInteraction: false,
        },
        initialSlide: 2,
        loop: true,
    });
</script>
